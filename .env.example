# ============================================================================
# PaperTrail AI settings
#   1. Copy this file to  backend\.env  (inside the backend folder, named exactly ".env")
#   2. Remove the leading "#" from any line you want to turn on
#   3. No spaces around "=" and no quotes. Restart the backend after every change.
# With no changes at all the app still works (keyword search, no AI, no key needed).
# ============================================================================

# ---------- TURN ON GEMINI AI ANSWERS: remove the "#" from these 3 lines ----------
# Get a free key at https://aistudio.google.com/apikey  (never share it or commit it)
# PAPERTRAIL_AI_PROVIDER=gemini
# PAPERTRAIL_GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
# PAPERTRAIL_GEMINI_MODEL=gemini-3.8-flash

# ---------- If Gemini is slow or times out ----------
# Seconds to wait for Gemini (default 30, max 120)
# PAPERTRAIL_AI_TIMEOUT_SECONDS=90
# Smaller = faster. Characters of passage text sent to Gemini (default 6000)
# PAPERTRAIL_AI_CONTEXT_CHARS=4000
# Passages retrieved per question (default 5)
# PAPERTRAIL_TOP_K=3
# Tip: also try a lighter model name from Google AI Studio in PAPERTRAIL_GEMINI_MODEL

# ---------- OPTIONAL: search by meaning (turn on after AI answers work) ----------
# PAPERTRAIL_EMBEDDING_PROVIDER=gemini
# PAPERTRAIL_RETRIEVAL_MODE=hybrid

# ---------- Basics (safe defaults; usually leave alone) ----------
PAPERTRAIL_DATA_DIR=./data
PAPERTRAIL_CORS_ORIGINS=["http://localhost:5173"]
PAPERTRAIL_MAX_UPLOAD_MB=20

# ---------- Advanced (all optional; values shown are the defaults) ----------
# PAPERTRAIL_CHUNK_SIZE=900
# PAPERTRAIL_CHUNK_OVERLAP=150
# PAPERTRAIL_MIN_TERM_COVERAGE=0.5
# PAPERTRAIL_AI_MAX_OUTPUT_TOKENS=1024
# PAPERTRAIL_AI_REQUESTS_PER_MINUTE=10
# PAPERTRAIL_AI_MAX_RETRIES=1
# PAPERTRAIL_ANSWER_CACHE_SIZE=128
# PAPERTRAIL_EMBEDDING_MODEL=gemini-embedding-001
# PAPERTRAIL_EMBEDDING_DIMENSIONS=768
# PAPERTRAIL_MIN_COSINE=0.62
# PAPERTRAIL_AUTO_EMBED=true
# PAPERTRAIL_AI_ENABLED=true
# Another OpenAI-compatible provider instead of Gemini (you must choose the model):
# PAPERTRAIL_OPENAI_API_KEY=
# PAPERTRAIL_OPENAI_MODEL=
# PAPERTRAIL_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ---------- Deployment only (see docs/deployment.md) ----------
# PAPERTRAIL_ACCESS_TOKEN=generate-a-long-random-value-at-least-16-characters
# PAPERTRAIL_ENABLE_DOCS=false
# PAPERTRAIL_SEED_SAMPLE=true
# Frontend build-time setting, set in the host's build environment:
# VITE_API_BASE=https://your-api-host/api/v1
